{
  "name": "word-match-app",
  "version": "1.0.0",
  "private": true,
  "description": "单词对对碰 — 单词匹配游戏 Android 应用（Capacitor 封装，零重写）",
  "type": "module",
  "scripts": {
    "prepare:www": "node scripts/prepare-www.mjs",
    "build:web": "esbuild src/shim.js --bundle --format=iife --target=es2019 --minify --outfile=www/shim.js",
    "sync": "npm run prepare:www && npm run build:web && cap sync",
    "audio": "/Users/kenneth/.workbuddy/binaries/python/envs/tts/bin/python scripts/make-audio.py --voice en-US-JennyNeural --rate=-15%",
    "apk:debug": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/preferences": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "esbuild": "^0.28.2"
  }
}
