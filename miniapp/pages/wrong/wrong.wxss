.wrap {
  padding: 24rpx 24rpx 60rpx;
}

.head {
  padding: 12rpx 8rpx 28rpx;
}

.head-title {
  font-size: 46rpx;
  font-weight: 800;
  color: var(--text);
}

.head-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.empty {
  padding: 160rpx 40rpx;
  text-align: center;
}

.empty-emoji {
  font-size: 76rpx;
}

.empty-text {
  margin-top: 20rpx;
  color: var(--muted);
  font-size: 26rpx;
}

.word {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--border);
  border-radius: var(--radius);
  padding: 24rpx 26rpx;
  margin-bottom: 16rpx;
  transition: transform 0.15s ease, border-color 0.15s ease;
}

.word-hover {
  transform: scale(0.98);
  border-color: var(--accent);
}

.word-main {
  flex: 1;
  min-width: 0;
}

.word-en {
  font-size: 31rpx;
  font-weight: 700;
  color: var(--text);
}

.word-count {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--warn);
  background: var(--card-hi);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin-left: 12rpx;
}

.word-zh {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.word-speak {
  font-size: 30rpx;
  opacity: 0.5;
  margin-left: 16rpx;
}

.word-del {
  margin-left: 22rpx;
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border: 1rpx solid var(--border);
  border-radius: 50%;
  color: var(--bad);
  font-size: 24rpx;
}

.actions {
  margin-top: 44rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.act-btn {
  width: 100%;
  border-radius: var(--radius-sm);
}

.act-btn::after {
  border: none;
}

.act-clear {
  background: var(--card);
  color: var(--bad);
  border: 1rpx solid var(--border);
  font-weight: 600;
}
